{
  "manifest_version": 3,
  "name": "HSU(한성대) 도구모음집",
  "version": "3.0.0",
  "description": "한성대 e-class에서 쓸 수 있는 도구 모음입니다. 상단바에 마크다운 메모장과 디데이를 추가하고, 강의 영상·과제의 남은 기간, 영상 시청 진도, 아직 보지 않은 영상과 과제 달력을 보여 줍니다.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://learn.hansung.ac.kr/*"],
      "exclude_matches": [
        "https://learn.hansung.ac.kr/mod/*/viewer.php*",
        "https://learn.hansung.ac.kr/login.php*",
        "https://learn.hansung.ac.kr/login/*"
      ],
      "js": ["memo-editor.js", "memo.js", "dday.js", "tone.js", "deadline.js", "progress.js", "todo.js", "watch.js", "calendar.js", "toolbox.js"],
      "css": ["memo.css", "dday.css", "deadline.css", "progress.css", "todo.css", "watch.css", "calendar.css", "toolbox.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://learn.hansung.ac.kr/mod/vod/viewer.php*"],
      "js": ["watch-player.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://learn.hansung.ac.kr/mod/vod/viewer.php*"],
      "js": ["watch-player-main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/menu-character.png", "watch.html"],
      "matches": ["https://learn.hansung.ac.kr/*"]
    }
  ]
}
